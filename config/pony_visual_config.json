  "animation": {
    "directions": {
      "required": ["down", "up", "left", "right"],
      "optional": ["up-left", "up-right", "down-left", "down-right"]
    },
    "requiredAnimations": [
      {
        "name": "IDLE",
        "description": "breathing or minimal body movement",
        "frames": 4
      },
      {
        "name": "WALK",
        "description": "coordinated movement of four legs",
        "frames": 4
      },
      {
        "name": "RUN",
        "description": "faster displacement and more dynamic animation",
        "frames": 4
      },
      {
        "name": "INTERACT",
        "description": "small body movement when using an object",
        "frames": 2
      },
      {
        "name": "SCARED",
        "description": "body and facial reaction to danger",
        "frames": 2
      },
      {
        "name": "HIDE",
        "description": "compact posture adapted to hiding",
        "frames": 1
      },
      {
        "name": "SPECIAL",
        "description": "particular movement of each character",
        "frames": 4
      }
    ],
    "requirements": {
      "transitions": "coherent",
      "proportions": "maintain character proportions",
      "maneAndTail": "can move slightly between frames but maintain consistent silhouette",
      "size": "do not arbitrarily change character size between frames"
    }
  },
  "perspective": {
    "camera": "2D RPG, preferably top-down",
    "reference": "Pinkie Pie image shows three-quarter lateral perspective",
    "usage": "use as reference for anatomy, proportions and finish, not as substitute for all directional sprites",
    "requirements": {
      "directions": "each character must maintain identifying features when looking up, down, left or right",
      "movement": {
        "sprites": "must orient according to character direction",
        "legs": "must animate coherently",
        "maneAndTail": "must maintain silhouette",
        "accessories": "must remain correctly placed",
        "cutieMarks": "must appear when perspective allows seeing them",
        "lighting": "must not erase main colors"
      },
      "collision": {
        "boxes": "define independent of visual sprite size",
        "allow": "player to move through rooms, cross doors and use hiding spots without being blocked by mane or tail"
      }
    }
  },
  "horrorIntegration": {
    "progression": "game must start with relatively colorful and friendly appearance, visual system must allow changes in lighting, shadows, expressions and animations as story progresses",
    "horrorVersions": {
      "maintain": "character identity",
      "doNotChange": "completely into generic creatures",
      "resources": [
        "Fixed gazes",
        "Fear expressions",
        "Subtle posture changes",
        "Pronounced shadows",
        "Red, bluish or violet lighting",
        "Unexpected mane movements",
        "Partially hidden silhouettes",
        "Special animations during chases"
      ],
      "darkness": "must generate tension without preventing player from recognizing characters or understanding what happens on screen"
    },
    "consistency": "maintain same pixel art style during menu, exploration, chases, cinematics and credits"
  },
